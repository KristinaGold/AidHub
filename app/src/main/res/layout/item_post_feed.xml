<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:animateLayoutChanges="true"
    android:clickable="false"
    app:cardBackgroundColor="@color/transparent"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="12dp"
            android:layout_marginVertical="6dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp"
            app:strokeColor="@color/stroke_color">


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/background"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:id="@+id/topLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">


                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/userImage"
                            style="@style/ProfileImage"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:clickable="true" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@id/userImage"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/userName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/open_sans_semibold"
                                android:text="Sarah Miller"
                                android:textColor="@color/text"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/postTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/open_sans"
                                android:text="2 hours ago"
                                android:textColor="@color/secondary_text"
                                android:textSize="12sp" />
                        </LinearLayout>


                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOptions"
                            style="@style/Widget.Material3.Button.IconButton.Outlined"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_alignParentEnd="true"
                            app:icon="@drawable/ic_dots"
                            app:iconGravity="textStart"
                            app:iconSize="26dp"
                            app:iconTint="@color/grey"
                            app:rippleColor="@color/grey"
                            app:strokeWidth="0dp" />

                    </RelativeLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/cgTags"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />


                    <TextView
                        android:id="@+id/postContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/open_sans"
                        android:lineSpacingExtra="4dp"
                        android:text="Available to watch your pets while you're away or take your dogs for walks..."
                        android:textColor="@color/text"
                        android:textSize="14sp"
                        android:textStyle="normal" />

                    <ImageView
                        android:id="@+id/postImg"
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:layout_gravity="start"
                        android:layout_marginVertical="12dp"
                        android:src="@drawable/img_award"
                        android:transitionName="request_image_transition"
                        android:visibility="gone" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnContact"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginEnd="6dp"
                            android:elevation="2dp"
                            android:text="Message"
                            android:textColor="@color/on_secondary_btn_color"
                            android:textSize="12sp"
                            app:backgroundTint="@color/secondary_btn_background_color"
                            app:icon="@drawable/ic_message"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:rippleColor="@color/grey"
                            app:iconTint="@color/on_secondary_btn_color"
                            app:toggleCheckedStateOnClick="true" />


                    </androidx.appcompat.widget.LinearLayoutCompat>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/optionsLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="50dp"
                    android:layout_marginEnd="15dp"
                    android:animateLayoutChanges="true"
                    android:backgroundTint="@color/secondary_background"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="5dp"
                    android:visibility="gone"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="5dp"
                    app:strokeColor="@color/icon_color"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:id="@+id/btnDelete"
                        android:layout_width="110dp"
                        android:layout_height="40dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Delete"
                            android:fontFamily="@font/open_sans_semibold"
                            android:textColor="@color/icon_color"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLike"
                style="@style/Widget.Material3.Button.IconButton.Outlined"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginEnd="5dp"
                android:background="@color/white"
                app:icon="@drawable/ic_heart"
                app:iconGravity="textStart"
                app:iconSize="25dp"
                app:iconTint="@color/like_button"
                app:strokeWidth="2dp"
                app:toggleCheckedStateOnClick="true" />

            <TextView
                android:id="@+id/txtLikes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sans"
                android:text="0 likes"
                android:textColor="@color/text"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>