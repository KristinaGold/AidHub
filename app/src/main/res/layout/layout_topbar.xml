<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.Toolbar xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/topBar"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:layout_marginTop="18dp"
    app:elevation="20dp"
    app:layout_collapseMode="pin">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginEnd="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditProfile"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/btnSettings"
            android:background="@drawable/bg_icon"
            android:gravity="center"
            android:visibility="gone"
            app:backgroundTintMode="src_over"
            app:icon="@drawable/ic_dots"
            app:iconSize="26dp"
            app:iconTint="@color/button_icon_color"
            app:rippleColor="@color/grey" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettings"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:background="@drawable/bg_icon"
            android:gravity="center"
            android:visibility="gone"
            app:backgroundTintMode="src_over"
            app:icon="@drawable/ic_dots"
            app:iconSize="26dp"
            app:iconTint="@color/button_icon_color"
            app:rippleColor="@color/grey" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.OutlinedButton.Icon"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@drawable/bg_icon"
            android:gravity="center"
            android:visibility="gone"
            app:backgroundTintMode="src_over"
            app:icon="@drawable/ic_back"
            app:iconGravity="textEnd"
            app:iconSize="26dp"
            app:iconTint="@color/button_icon_color"
            app:rippleColor="@color/grey"
            app:strokeWidth="0dp" />

        <TextView
            android:id="@+id/screenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@+id/btnBack"
            android:fontFamily="@font/open_sans_bold"
            android:text="Request Details"
            android:textAlignment="center"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/searchContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="start"
            android:orientation="horizontal"
            android:layout_marginEnd="6dp"
            android:animateLayoutChanges="false"
            android:layout_toStartOf="@+id/topHelpRequest"
            android:layout_alignParentStart="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            >

            <androidx.appcompat.widget.SearchView
                android:id="@+id/searchViewSkills"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_search_view"
                android:inputType="textCapWords"
                android:visibility="visible"
                app:closeIcon="@drawable/ic_close"
                app:iconifiedByDefault="false"
                app:queryBackground="@color/transparent"
                app:queryHint="Search posts"
                app:rippleColor="@color/grey"
                app:searchIcon="@drawable/ic_search"
                android:focusable="false"
                android:focusableInTouchMode="false"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/topHelpRequest"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/layoutNotifications"
            android:background="@drawable/bg_icon"
            android:visibility="gone"
            app:backgroundTintMode="src_over"
            app:icon="@drawable/ic_help_top"
            app:iconSize="26dp"
            app:iconTint="@color/button_icon_color"
            app:rippleColor="@color/grey" />

        <FrameLayout
            android:id="@+id/layoutNotifications"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:clipChildren="false"
            android:clipToPadding="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNotification"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_icon"
                app:backgroundTintMode="src_over"
                app:icon="@drawable/ic_notification"
                app:iconSize="26dp"
                app:iconTint="@color/button_icon_color"
                app:rippleColor="@color/grey" />

            <TextView
                android:id="@+id/notificationBadge"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="top|center"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_red_dot"
                android:gravity="center"
                android:text="5"
                android:textColor="@color/badge_text_color"
                android:textSize="10sp"
                android:textStyle="bold" />

        </FrameLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            app:chipSpacingHorizontal="5dp">

            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </com.google.android.material.chip.ChipGroup>

    </RelativeLayout>

</androidx.appcompat.widget.Toolbar>